{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://terraviz.zyra-project.org/schema/v1/dataset.schema.json",
  "title": "Terraviz wire Dataset",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "dataLink": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "abstractTxt": {
      "type": "string"
    },
    "thumbnailLink": {
      "type": "string"
    },
    "legendLink": {
      "type": "string"
    },
    "closedCaptionLink": {
      "type": "string"
    },
    "colorTableLink": {
      "type": "string"
    },
    "websiteLink": {
      "type": "string"
    },
    "startTime": {
      "type": "string"
    },
    "endTime": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "weight": {
      "type": "number"
    },
    "isHidden": {
      "type": "boolean"
    },
    "runTourOnLoad": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enriched": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "categories": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedDatasets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "url"
            ]
          }
        },
        "datasetDeveloper": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "affiliationUrl": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "visDeveloper": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "affiliationUrl": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        }
      }
    },
    "originNode": {
      "type": "string"
    },
    "originNodeUrl": {
      "type": "string"
    },
    "originDisplayName": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "federated",
        "restricted",
        "private"
      ]
    },
    "schemaVersion": {
      "type": "number"
    },
    "licenseSpdx": {
      "type": "string"
    },
    "licenseUrl": {
      "type": "string"
    },
    "licenseStatement": {
      "type": "string"
    },
    "attributionText": {
      "type": "string"
    },
    "rightsHolder": {
      "type": "string"
    },
    "doi": {
      "type": "string"
    },
    "citationText": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string"
    },
    "legacyId": {
      "type": "string"
    },
    "probingInfo": {},
    "boundingBox": {
      "type": "object",
      "properties": {
        "n": {
          "type": "number"
        },
        "s": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "e": {
          "type": "number"
        }
      },
      "required": [
        "n",
        "s",
        "w",
        "e"
      ]
    },
    "celestialBody": {
      "type": "string"
    },
    "radiusMi": {
      "type": "number"
    },
    "lonOrigin": {
      "type": "number"
    },
    "isFlippedInY": {
      "type": "boolean"
    },
    "renderEncoding": {
      "type": "string",
      "const": "data-luma"
    },
    "colorScale": {
      "type": "object",
      "properties": {
        "stops": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "t": {
                "type": "number"
              },
              "rgba": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "t",
              "rgba"
            ]
          }
        },
        "vmin": {
          "type": "number"
        },
        "vmax": {
          "type": "number"
        },
        "units": {
          "type": "string"
        },
        "transparentRange": {
          "type": "number"
        },
        "dataMinLuma": {
          "type": "number"
        }
      },
      "required": [
        "stops",
        "vmin",
        "vmax"
      ]
    },
    "experience": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "textTracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "vtt",
                  "srt",
                  "unknown"
                ]
              },
              "language": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "isDefault": {
                "type": "boolean"
              }
            },
            "required": [
              "source",
              "format",
              "language"
            ]
          }
        },
        "audioTracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "volume": {
                "type": "number"
              },
              "startOffsetMs": {
                "type": "number"
              },
              "sync": {
                "type": "string",
                "const": "dataset-clock"
              }
            },
            "required": [
              "source",
              "sync"
            ]
          }
        },
        "playbackPolicy": {
          "type": "object",
          "properties": {
            "firstDwellMs": {
              "type": "number"
            },
            "lastDwellMs": {
              "type": "number"
            }
          }
        },
        "composition": {
          "type": "object",
          "properties": {
            "layers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ordinal": {
                    "type": "number"
                  },
                  "name": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "opacity": {
                    "type": "number"
                  },
                  "visible": {
                    "type": "boolean"
                  },
                  "blendMode": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "multiply",
                      "screen",
                      "add"
                    ]
                  },
                  "syncGroup": {
                    "type": "string"
                  },
                  "sourceMetadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "ordinal",
                  "name",
                  "source"
                ]
              }
            }
          },
          "required": [
            "layers"
          ]
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ordinal": {
                "type": "number"
              },
              "source": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "image",
                  "video",
                  "text",
                  "live",
                  "unknown"
                ]
              },
              "placement": {
                "type": "string",
                "enum": [
                  "viewport",
                  "globe",
                  "projector"
                ]
              },
              "pathSource": {
                "type": "string"
              },
              "opacity": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "sourceMetadata": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "ordinal",
              "source",
              "kind",
              "placement"
            ]
          }
        },
        "assetRights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "licenseSpdx": {
                "type": "string"
              },
              "licenseUrl": {
                "type": "string"
              },
              "licenseStatement": {
                "type": "string"
              },
              "attributionText": {
                "type": "string"
              },
              "rightsHolder": {
                "type": "string"
              }
            },
            "required": [
              "source"
            ]
          }
        }
      },
      "required": [
        "version"
      ]
    },
    "tourJsonUrl": {
      "type": "string"
    },
    "frames": {
      "type": "object",
      "properties": {
        "count": {
          "type": "number"
        },
        "urlTemplate": {
          "type": "string"
        },
        "framesDigest": {
          "type": "string"
        }
      },
      "required": [
        "count",
        "urlTemplate"
      ]
    }
  },
  "required": [
    "id",
    "slug",
    "title",
    "format",
    "dataLink",
    "originNode",
    "originNodeUrl",
    "originDisplayName",
    "visibility",
    "schemaVersion",
    "createdAt",
    "updatedAt"
  ]
}
